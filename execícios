_____________METODOS_______________

#include <iostream>
#include <string>

using namespace std;

int contarVogais(string frase) {
   int contador = 0;

   for (int i = 0; i < frase.length(); i++) {
      if (frase[i] == 'a' || frase[i] == 'e' || frase[i] == 'i' ||
          frase[i] == 'o' || frase[i] == 'u') {
         contador++;
      }
   }

   return contador;
}

