#include <iostream>

using namespace std;

#include "metodos.h"

int main() {
   int vetor[] = {1, 2, 3, 4, 5};
   int tamanho = 5;

   if (verificarOrdenado(vetor, tamanho)) {
      cout << "Vetor ordenado." << endl;
   } else {
      cout << "Vetor desordenado." << endl;
   }

   return 0;
}

__________METODOS____________

#include <iostream>

using namespace std;

bool verificarOrdenado(int vetor[], int tamanho) {
   for (int i = 0; i < tamanho - 1; i++) {
      if (vetor[i] > vetor[i + 1]) {
         return false;
      }
   }

   return true;
}

