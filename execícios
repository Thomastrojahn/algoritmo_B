#include <iostream>
#include <string>

using namespace std;

#include "metodos.h"

int main() {
   string nome;

   cout << "Digite seu nome completo: ";
   getline(cin, nome);

   cout << "Primeiro nome: " << primeiroNome(nome) << endl;

   return 0;
}

_______________METODOS_____________

#include <iostream>
#include <string>

using namespace std;

string primeiroNome(string nome) {
   string primeiro = "";

   for (int i = 0; i < nome.length(); i++) {
      if (nome[i] == ' ') {
         break;
      }

      primeiro += nome[i];
   }

   return primeiro;
}


