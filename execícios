using namespace std;

#include "metodos.h"

int main() {
   string frase;

   cout << "Digite uma frase: ";
   getline(cin, frase);

   frase = maiuscula(frase);

   cout << "Frase em maiuscula: " << frase << endl;

   return 0;
}

___________METODOS__________

#include <iostream>
#include <string>

using namespace std;

string maiuscula(string frase) {
   for (int i = 0; i < frase.length(); i++) {
      frase[i] = toupper(frase[i]);
   }

   return frase;
}

